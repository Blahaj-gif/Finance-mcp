# Credentials — never commit
.env
conf/token.txt

# SDK logs: these have historically contained the app key, request signatures
# and full response bodies. Keep them out of version control unconditionally.
*.log
*.log.*
conf/*.log*

# Local state written by the MCP tools
dashboard/trading_journal.json
dashboard/alerts.json
dashboard/order_drafts.json
*.tmp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Windows folder metadata
desktop.ini
Thumbs.db
iv_history.json

# Streamlit local secrets (config.toml is committed; secrets.toml never is)
.streamlit/secrets.toml

# Read-only extraction from Powerstation for review. 421 files, 4.1 MB, with a
# sha256 manifest; it does not build and is not a dependency. The pieces we
# adopted are vendored explicitly (dashboard/ta_core.py, tests/fixtures/).
extract-chart-dsl/
dashboard/portfolio_history.json

# Shared on-disk bar cache. Derived data, regenerated on demand.
conf/barcache/

# One-time live-trading acknowledgement, per account. Local state.
dashboard/live_consent.json

# The mcp-publisher binary, fetched on demand. 20 MB of Go, not source.
tools/

# Everything the dashboard writes beside its own code. Listed one by one this
# missed iv_history.json, which was untracked but not ignored -- one `git add
# -A` from being committed, and it had already shipped in four releases via
# setuptools, which globs the filesystem rather than the git index.
dashboard/*.json

# A separate project with its own git repository, kept in this folder for
# convenience only. Nothing in Finance MCP imports it and nothing in it imports
# Finance MCP.
crossfoot/
# Its successor. Same reason: a separate repository that happens to live in
# this working tree.
pgsow/
