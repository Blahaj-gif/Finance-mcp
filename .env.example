# Copy to .env and fill in. .env is gitignored; this file is not.
# The installer writes a .env for you — this copy is for the clone-the-repo path.
#
# KEY=VALUE only. This file is not INI: a [section] header, and every line under
# it, would otherwise be read as environment variables — which is how a PyPI
# token pasted in from a .pypirc became os.environ["PASSWORD"] in the server
# process. The loader now stops at the first [section] and says so on stderr.

# --- Which broker ------------------------------------------------------
# webull | saxo | ibkr. Selects the adapter behind the account and order tools,
# and the feed prices come from. Only the tools the configured broker can serve
# are registered, so `tools/list` never advertises one that would refuse.
#
# Webull is the only adapter that has been run against a live account. Saxo and
# IBKR are written from published documentation and say so in every result they
# produce. See HELP-WANTED.md.
FINANCE_BROKER=webull

# --- Webull OpenAPI ---------------------------------------------------
# Without these the price feed falls back to Yahoo (announced in every result)
# and no account, position or order tool will work at all.
WEBULL_APP_KEY=YOUR_WEBULL_APP_KEY_HERE
WEBULL_APP_SECRET=YOUR_WEBULL_APP_SECRET_HERE
WEBULL_REGION_ID=th

# prod  -> the real account. An approved order spends real money.
# paper -> Webull's simulated environment. Orders are routed to the sandbox
#          host for your region and fill against simulated inventory. Use this
#          to rehearse the approval path end to end without risking anything.
#          (Aliases: uat, sandbox, simulated.)
# The dashboard shows LIVE or PAPER next to the wordmark and on the Execution
# tab, so which surface is active is never something you have to remember.
WEBULL_ENVIRONMENT=prod

# Pin this if your login has more than one account. The server refuses to guess
# rather than silently trading the wrong one.
# WEBULL_ACCOUNT_ID=

# --- Saxo Bank (only if FINANCE_BROKER=saxo) --------------------------
# UNVERIFIED ADAPTER. Never run against Saxo's API.
# A 24-hour simulation token comes from the Developer Portal with no approval
# process and no live money; live access needs the OAuth2 code flow.
# SAXO_ENVIRONMENT=sim            # sim | live
# SAXO_ACCESS_TOKEN=
# Pin these if the login has more than one account or client.
# SAXO_ACCOUNT_KEY=
# SAXO_CLIENT_KEY=

# --- Interactive Brokers (only if FINANCE_BROKER=ibkr) ----------------
# UNVERIFIED ADAPTER. Never run against IBKR's API.
# This is the Client Portal *Web* API, not the TWS socket API. Run IBKR's
# Client Portal Gateway, then log in at https://localhost:5000 in a browser.
# A paper account works and is the better choice; paper ids start DU.
# IBKR_BASE_URL=https://localhost:5000/v1/api
# IBKR_ACCOUNT_ID=
#
# Only consulted when the account id is not pinned above. An account id starting
# DU is recognised as paper on its own. Where neither is known the label is
# LIVE, because the failure directions are not symmetric: calling a live account
# PAPER invites someone to approve an order they would have refused.
# IBKR_ENVIRONMENT=live
#
# The gateway serves a self-signed certificate. Accepting it unverified is a
# decision about the connection carrying your orders, so it is not made for
# you: either point IBKR_CACERT at the gateway's certificate, or opt in.
# IBKR_CACERT=
# IBKR_TLS_INSECURE=
#
# Only the hosted api.ibkr.com endpoint takes a bearer token. The local gateway
# holds the session itself and wants no Authorization header at all.
# IBKR_ACCESS_TOKEN=

# --- Macro release watching -------------------------------------------
# Off by default. When on, a background thread wakes 10 seconds before a
# scheduled BLS release and polls until the print lands, so the number is
# already in hand when you ask instead of being fetched at that moment.
# Costs one or two API calls for a punctual release, ~99 worst case if one
# never arrives, against a 500/day registered quota. Without it the answer
# is still the freshest available whenever you ask -- just not pre-fetched.
# FINANCE_MACRO_WATCH=1
#
# Where the watcher records what it saw. Every filing, macro landing and
# Treasury buyback operation is appended here once, and `get_updates` reads it
# so the first thing you ask after an event already knows about it. Delete the
# file to start again; the watcher will re-notify whatever is still in the
# feeds, which is why the default is next to the code rather than in /tmp.
# FINANCE_EVENTS_PATH=dashboard/events.jsonl
#
# How often the filing and buyback sources are asked, in seconds. A macro
# release is on a calendar and can be waited for; a filing is not, so the loop
# cannot sleep through it. SEC permits ten requests a second and this is one a
# minute, which bounds how late a filing can be noticed.
# FINANCE_FILING_POLL_SECONDS=60

# --- SEC EDGAR --------------------------------------------------------
# No API key, but the SEC's fair-access policy requires a descriptive
# User-Agent with a real contact address. The filings tools refuse to send
# requests without one rather than risk an IP ban on your address.
SEC_USER_AGENT=Your Name (you@example.com)

# --- Optional public data ---------------------------------------------
# BLS works with no key at 25 queries/day; a free key at
# https://data.bls.gov/registrationEngine/ raises it to 500/day.
BLS_API_KEY=

# FRED works keyless via the CSV endpoint. A free key at
# https://fredaccount.stlouisfed.org/apikeys switches to the JSON API.
FRED_API_KEY=

# BEA requires a key: https://apps.bea.gov/API/signup/
BEA_API_KEY=

# --- Rate limiting (leave alone unless you are being throttled) --------
# WEBULL_MIN_REQUEST_INTERVAL=0.25
# WEBULL_MAX_RETRIES=3
# WEBULL_RETRY_BACKOFF=0.75
# YF_MIN_REQUEST_INTERVAL=0.35
# YF_MAX_RETRIES=3
# YF_RETRY_BACKOFF=1.5

# Run tests/test_live_sources.py against the real internet instead of skipping
# it. Off by default: a suite that fails because SEC returned a 503 overnight is
# a suite nobody trusts. On, it is the only thing that catches a source which
# has quietly stopped publishing.
#   FINANCE_LIVE_SOURCES=1 pytest tests/test_live_sources.py -v -s
FINANCE_LIVE_SOURCES=
